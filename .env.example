# Global Election Monitor: private settings for this computer.
# Not committed to GitHub (.gitignore lists .env). Never paste these values into chats or code.
# One setting per line: NAME=value, no quotes, no spaces around "=", no comments on the same line.
# Leave a value empty (or keep the line commented with #) if you don't have it. Nothing here is required.
# The dashboard's Settings page can edit all of these too.

# ----- Server -----
# Port the dashboard runs on (default 4380)
GP_PORT=
# Address to listen on. Default 127.0.0.1 (this computer only). 0.0.0.0 opens it to your network; then set ADMIN_TOKEN.
HOST=
# Password for changing settings from another device. Make up a long random string.
ADMIN_TOKEN=
# Set to 1 to open the browser automatically when the server starts
OPEN_BROWSER=

# ----- Results data -----
# Election.org developer key (free, read-only). Create at https://election.org/api/developers
ELECTION_API_KEY=
# Harvard Dataverse API token (free account). Downloads MIT's full U.S. House 1976-2024 file.
# Create at https://dataverse.harvard.edu -> your name -> API Token
DATAVERSE_API_TOKEN=
# Associated Press Elections API key (paid licence) - only if you buy one
AP_API_KEY=
# Victorian Electoral Commission feed addresses - only after the VEC approves your access
VEC_FEED_URL=
VEC_CANDIDATES_URL=

# ----- Social (check cost and terms before using) -----
# X (Twitter) API bearer token (paid tiers)
X_BEARER_TOKEN=
# Reddit app credentials (free script app at https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Canada (Elections Canada) and the other public sources need no keys.
