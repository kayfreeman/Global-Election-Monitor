# Copy to .env and fill in only what you have. Nothing here is required to run.
# Keep .env private: it is in .gitignore and must never be committed or pasted into chats.
# One setting per line, no quotes or trailing comments. The Settings page can edit these too.

# --- Server ---
# GP_PORT=4380
# HOST=127.0.0.1            (0.0.0.0 opens it on your network; then also set ADMIN_TOKEN)
# ADMIN_TOKEN=

# --- Results data ---
# Election.org developer key (free, read-only): https://election.org/api/developers
ELECTION_API_KEY=
# AP_API_KEY=
# VEC_FEED_URL=
# VEC_CANDIDATES_URL=
# AEC_FEED_HOST=
# ECNZ_FEED_URL=

# --- Social (check cost and terms first) ---
# X_BEARER_TOKEN=
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
