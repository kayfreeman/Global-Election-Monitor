# Copy to .env and fill in only what you have. Nothing here is required to run.
# GP_PORT=4380
# HOST=127.0.0.1            # use 0.0.0.0 to open on your network (then set ADMIN_TOKEN)
# ADMIN_TOKEN=change-me      # moderator token for verify/reject, sim controls, polls, streams

# Results feeds (adapters for these are the next build step)
# AP_API_KEY=
# AEC_FEED_HOST=
# VEC_FEED_URL=
# INEC_FEED_URL=
# ECNZ_FEED_URL=

# Social (check cost and terms first)
# X_BEARER_TOKEN=
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
